GRAVITYBOT_DRY_RUN=true   # or false for production

# ORGANIZATIONAL SMTP SERVER CREDENTIALS
SMTP_HOST               = "<smtp.host.extension>"       # Your Orgs SMTP Host
SMTP_USER               = "<SMTP@email.org>"            # Org user email Credential
SMTP_PASS               = "<SMTP password>"             # Org SMTP Password
SMTP_FROM               = ""                            # Who should send the email?
SMTP_TO                 = "gravityspy@listserv.syr.edu"

# Azure OpenAI
AZURE_OPENAI_API_KEY=<your key>
AZURE_OPENAI_ENDPOINT=<your endpoint>
AZURE_OPENAI_API_VERSION=<your version>
AZURE_OPENAI_DEPLOYMENT=<your deployment>   # selected model: gpt-6.1-sol
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<your deployment>

# PANOPTES / ZOONIVERSE CREDENTIALS
PANOPTES_SLUG           = "zooniverse/<your-zooniverse-slug>"
PANOPTES_USER           = "<a-project-user-with-proper-data-access>"
PANOPTES_PASS           = "<the-above-users-password>"
PANOPTES_ID             = "<see: get_user_id.py>"

# aLOG prompt: interface (default), volunteer or legacy
GRAVITYBOT_ALOG_PROMPT=interface

# The interface prompt looks up acronyms in the LIGO Abbreviations and Acronyms list
# (DCC M080375-v26), which is not stored in the repository. Place
# "M080375-v26 Abbreviations and Acronyms.csv" in the data folder (default _data/,
# or GRAVITYBOT_DATA_FOLDER_PATH). Without it, only the Hanford corrections are used.
